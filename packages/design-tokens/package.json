{
  "name": "@<REDACTED>/phenotype-design-tokens",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Shared CSS and Tailwind tokens for Phenotype landing pages (canonical home: phenoDesign)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": "./tokens.css",
    "./tokens.css": "./tokens.css",
    "./tailwind": "./tailwind.config.mjs",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    }
  },
  "files": [
    "dist",
    "tokens.css",
    "tailwind.config.mjs"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KooshaPari/phenoDesign",
    "directory": "packages/design-tokens"
  },
  "devDependencies": {
    "typescript": "latest"
  }
}
