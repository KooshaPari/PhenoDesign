{
  "name": "@kooshapari/phenotype-design-tokens",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Shared CSS and Tailwind tokens for Phenotype landing pages (canonical home: phenoDesign)",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./css": "./tokens.css",
    "./tokens.css": "./tokens.css",
    "./tailwind": "./tailwind.config.mjs",
    "./tokens": {
      "types": "./tokens.d.ts",
      "import": "./tokens.js"
    }
  },
  "files": [
    "tokens.css",
    "tokens.js",
    "tokens.d.ts",
    "index.js",
    "index.d.ts",
    "tailwind.config.mjs"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KooshaPari/phenoDesign",
    "directory": "packages/design-tokens"
  },
  "devDependencies": {
    "typescript": "latest"
  }
}
