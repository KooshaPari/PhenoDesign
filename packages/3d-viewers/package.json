{
  "name": "@kooshapari/phenotype-3d-viewers",
  "version": "0.1.0",
  "description": "Three.js GLB viewer with orbit controls, auto-rotate, and product lighting presets for Phenotype projects",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./glb-viewer": { "types": "./dist/glb-viewer.d.ts", "import": "./dist/glb-viewer.js" },
    "./lighting-presets": { "types": "./dist/lighting-presets.d.ts", "import": "./dist/lighting-presets.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KooshaPari/phenoDesign",
    "directory": "packages/3d-viewers"
  },
  "publishConfig": { "access": "public" },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "typescript": "latest",
    "three": "latest",
    "@types/three": "latest"
  },
  "license": "MIT"
}
