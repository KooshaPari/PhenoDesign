{
  "name": "@kooshapari/phenotype-design-utils",
  "version": "0.1.0",
  "description": "Shared design utilities for Phenotype projects: color, typography, spacing, motion, and layout",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./color": {
      "types": "./dist/color.d.ts",
      "import": "./dist/color.js"
    },
    "./type-scale": {
      "types": "./dist/type-scale.d.ts",
      "import": "./dist/type-scale.js"
    },
    "./spacing": {
      "types": "./dist/spacing.d.ts",
      "import": "./dist/spacing.js"
    },
    "./motion": {
      "types": "./dist/motion.d.ts",
      "import": "./dist/motion.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KooshaPari/phenoDesign",
    "directory": "packages/design-utils"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "latest"
  }
}
